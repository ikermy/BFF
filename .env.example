# ─────────────────────────────────────────────────────────────────────────────
# BFF — шаблон переменных окружения (эталон).
# Скопируйте в `.env` (git-ignore) и отредактируйте под своё окружение:
#   cp .env.example .env
# Значения по умолчанию = тестовый режим с legacy-интеграцией BarcodeGen.
# ─────────────────────────────────────────────────────────────────────────────

# ── BFF ──────────────────────────────────────────────────────────────────────
BFF_PORT=8080
INTERNAL_SERVICE_JWT=dev-internal-token
ADMIN_JWT=dev-admin-token
UNIT_PRICE=0.50

# Auth / внутренние токены (grpc_kafka_fixes §1.1, отчёт §4.2 п.1)
# JWT_SECRET — секрет валидации пользовательских токенов (общий с Auth Service).
JWT_SECRET=dev-jwt-secret
# JWT_ACCESS_SECRET — секрет минта сервисных JWT для legacy-адаптера BarcodeGen.
# ОБЯЗАН совпадать с JWT_ACCESS_SECRET в BarcodeGen.
JWT_ACCESS_SECRET=dev-barcodegen-access-secret

# ── BarcodeGen (legacy-адаптер, отчёт §4) ────────────────────────────────────
# native = http_client.go (контракт ТЗ); legacy = ACL под реальный BarcodeGen.
BARCODEGEN_MODE=legacy
BARCODEGEN_URL=http://barcodegen:8080
# barcode-raw-svc для GenerateRaw (этап 5). Пусто = raw выключен.
BARCODEGEN_RAW_URL=http://barcode-raw:8080
BARCODEGEN_TIMEOUT=30000

# ── Перекладка артефактов PNG (D2 этап 2, отчёт §4.3) ────────────────────────
ARTIFACT_DIR=/app/artifacts
ARTIFACT_PUBLIC_URL=http://localhost:8080/artifacts

# ── Downstream services ──────────────────────────────────────────────────────
BILLING_URL=http://billing:3000
BILLING_INTERNAL_API_KEY=dev-billing-key
AI_URL=http://ai-service:8080
HISTORY_URL=http://history:3000
AUTH_URL=http://auth-service:3000
NOTIFICATIONS_URL=http://notifications:3000
TRANS_HISTORY_URL=http://trans-history:3000

# ── Kafka / Redis ────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=bff-bulk-worker
REDIS_URL=redis://redis:6379/0

# ── Timeouts (ms) ────────────────────────────────────────────────────────────
BILLING_TIMEOUT=5000
AI_TIMEOUT=60000

# ── Idempotency TTL (секунды → 24ч) ──────────────────────────────────────────
IDEMPOTENCY_TTL=86400

# ── Feature flags (тестовый режим) ───────────────────────────────────────────
ENABLE_PARTIAL_SUCCESS=true
ENABLE_IDEMPOTENCY=true
ENABLE_LEGACY_AUTH=true
ENABLE_NOTIFICATIONS=true
MAINTENANCE_MODE=false

# ── Prod / Envoy (docker-compose.prod.yml) ───────────────────────────────────
# Домен, для которого Envoy выпускает Let's Encrypt-сертификат.
# DOMAIN=example.com

# ═════════════════════════════════════════════════════════════════════════════
# Переменные для самого BARCODEGEN (его собственный env, отдельный деплой).
# ═════════════════════════════════════════════════════════════════════════════
#   JWT_ACCESS_SECRET=dev-barcodegen-access-secret   # = JWT_ACCESS_SECRET BFF
#   PORT=6002                                        # D2
#   KAFKA_ENABLED=false                              # C1
#   BILLING_URL=http://bff:8080/internal/v1/billing  # D1 (billing-stub BFF)
#   BARCODE_URL=http://barcodegen:8080               # базовый URL PNG
